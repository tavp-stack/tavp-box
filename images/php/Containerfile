FROM php:8.3-fpm

LABEL org.opencontainers.image.source="https://github.com/tavp-stack/tavpbox"
LABEL org.opencontainers.image.description="TAVPBox PHP 8.3 with Nginx, MariaDB, Redis, Mailpit"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Jakarta

# Install system packages
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    nginx \
    mariadb-server mariadb-client \
    redis-server \
    libpq-dev \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libsqlite3-dev \
    locales \
    tzdata \
    curl wget git unzip \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions (only missing ones)
RUN docker-php-ext-install mysqli pdo_mysql pdo_pgsql gd zip

# Install Phalcon
RUN pecl channel-update pecl.php.net 2>/dev/null \
    && pecl install phalcon 2>/dev/null || true \
    && echo "extension=phalcon.so" > /usr/local/etc/php/conf.d/phalcon.ini

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y -qq --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Mailpit
RUN curl -sL https://github.com/axllent/mailpit/releases/download/v1.21.1/mailpit-linux-amd64.tar.gz | tar xz -C /usr/local/bin/

# Install PHP 8.4 from sury.org (multi-PHP: 8.3+Phalcon stays default, #27)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    lsb-release ca-certificates curl gnupg \
    && curl -fsSL https://packages.sury.org/php/apt.gpg -o /usr/share/keyrings/sury-php.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ trixie main" > /etc/apt/sources.list.d/sury-php.list \
    && { printf 'Package: php8.4*\nPin: release *\nPin-Priority: 500\n\nPackage: php-common\nPin: release *\nPin-Priority: 500\n\n'; cat /etc/apt/preferences.d/no-debian-php; } > /tmp/prefs.new \
    && mv /tmp/prefs.new /etc/apt/preferences.d/no-debian-php \
    && apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    php8.4-fpm php8.4-cli php8.4-mysql php8.4-gd php8.4-zip php8.4-bcmath php8.4-intl php8.4-mbstring php8.4-xml php8.4-curl \
    && rm -rf /var/lib/apt/lists/*

# Configure nginx
COPY nginx.conf /etc/nginx/sites-available/default

# Start script
COPY start.sh /usr/local/bin/tavpbox-start.sh
RUN chmod +x /usr/local/bin/tavpbox-start.sh

CMD ["/usr/local/bin/tavpbox-start.sh"]
